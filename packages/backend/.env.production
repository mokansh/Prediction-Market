# Production Environment Variables for Railway

# Server Configuration
NODE_ENV=production
PORT=3001

# Blockchain Configuration
RPC_URL=https://rpc-amoy.polygon.technology/
SAFE_PROXY_FACTORY_ADDRESS=0x50468d520D77BBA5129C24135A24a3a1d621afca
ADMIN_PRIVATE_KEY=a07ccacc5575eadc7fbaf81f008322a2a0de5dfb2c1c4940416242fbb6be015a

# Database (Railway will provide DATABASE_URL)
DATABASE_URL=postgresql://user:password@localhost:5432/polymarket

# Redis (Railway will provide REDIS_URL)
REDIS_URL=redis://localhost:6379

# API Configuration
CORS_ORIGIN=https://your-frontend.vercel.app

# WebSocket Configuration
WS_PORT=3001

# Collateral Token (USDC on Polygon Amoy Testnet)
COLLATERAL_TOKEN=0x7006b5a13d347dab68b9c2caabee2e6bc11296fd
COLLATERAL_TOKEN_ADDRESS=0x7006b5a13d347dab68b9c2caabee2e6bc11296fd

CTF_EXCHANGE_ADDRESS=0x605921c2eC6E761945bEEA78D46b81f045dc0399

# Market Creation Contracts (Polygon Amoy Testnet)
# UMA CTF Adapter - deployed at block 0x1ebb0e2
# UMA_CTF_ADAPTER_ADDRESS=0xe45c422d27c517e6239c455cda2a52fe18ff096c
UMA_CTF_ADAPTER_ADDRESS=0x98c7b8780fD12CD8947B034ED74875C3Ed94010C
# Conditional Tokens Framework
CONDITIONAL_TOKENS_ADDRESS=0x53dBaF3856166A512dA9A53c470A820b8cD7195c
# Reward token for UMA Oracle (address(0) for no reward, or USDC address)
REWARD_TOKEN_ADDRESS=0x87D6cFE8fcdc8B87480DEEAB4aee868C7D5252AE
# Reward amount in wei (0 for no reward)
REWARD_AMOUNT=0
# Proposal bond in wei (0 uses default)
PROPOSAL_BOND=0
# Liveness period in seconds (default 7200 = 2 hours)
LIVENESS=7200

FEE_MODULE_ADDRESS=0xf3a583bb90B991FeCa91dF9844c1e4c380aA609C

# CTF Event Listener
CTF_CONTRACT_ADDRESS=0x53dBaF3856166A512dA9A53c470A820b8cD7195c
NEG_RISK_FEE_MODULE=0xf3a583bb90B991FeCa91dF9844c1e4c380aA609C